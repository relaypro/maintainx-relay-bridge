# Copy to .env for local runs. On a host, set these as secrets / environment variables.

# Relay Dash > Help > API Keys (Enterprise plan)
RELAY_API_KEY=
# Relay Dash > Help > Diagnostic Logs > Server Details > Subscriber
RELAY_SUBSCRIBER_ID=
# MaintainX > Settings > Integrations > Webhooks > Copy secret
MAINTAINX_WEBHOOK_SECRET=

# Relay routes: who hears each kind of event, and how. Group names must match
# Relay Workflow Groups exactly. Omit to use the defaults (both routes -> maintenance).
RELAY_ROUTES={"urgent":{"mode":"alert","groups":["maintenance","shift-leads"],"timeout":300,"quorum":1,"on_quorum":"Someone else has this work order."},"notice":{"mode":"broadcast","groups":["maintenance"]}}

# Optional: MaintainX > Settings > Integrations > API Keys. Adds titles and
# locations to spoken alerts. Requires a Premium or Enterprise plan.
MAINTAINX_API_KEY=

# true logs Relay requests instead of sending them.
DRY_RUN=true

PORT=3000
